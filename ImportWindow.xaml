<Window x:Class="WindowsOtpManager.ImportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Add authenticator account" Width="570" Height="650" MinWidth="530" MinHeight="620" WindowStartupLocation="CenterOwner" Background="#C0C0C0" FontFamily="Tahoma" ResizeMode="CanResize">
 <Window.Resources>
  <Style x:Key="Primary" TargetType="Button"><Setter Property="Background" Value="#C0C0C0"/><Setter Property="Foreground" Value="#101010"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="14,7"/><Setter Property="BorderBrush" Value="#404040"/><Setter Property="BorderThickness" Value="2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="2"/></Style>
  <Style x:Key="Soft" TargetType="Button"><Setter Property="Background" Value="#C0C0C0"/><Setter Property="Foreground" Value="#101010"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="12,7"/><Setter Property="BorderBrush" Value="#404040"/><Setter Property="BorderThickness" Value="2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="2"/></Style>
 </Window.Resources>
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#000080" Padding="10" Margin="0,0,0,13"><StackPanel><TextBlock Text="Add an account" FontSize="20" FontWeight="Bold" Foreground="White"/><TextBlock Text="Copy your authenticator into SecureKey. The original account stays where it is." FontSize="11" Foreground="#E4E4FF" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
  <Border Grid.Row="1" Background="#D4D0C8" BorderBrush="#808080" BorderThickness="2" Padding="10" Margin="0,0,0,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="34" Height="34" Background="#000080" BorderBrush="White" BorderThickness="1"><TextBlock Text="▣" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0"><TextBlock Text="Scan QR code" FontWeight="Bold" Foreground="#101010"/><TextBlock Text="Choose a camera and scan your authenticator export." FontSize="10" Foreground="#404040" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="2" Style="{StaticResource Soft}" Content="Open camera" Click="Scan_Click"/></Grid></Border>
  <StackPanel Grid.Row="2"><TextBlock Text="OR IMPORT URI" FontSize="10" Foreground="#202020" FontWeight="Bold" Margin="2,0,0,7"/><TextBox x:Name="UriBox" Height="92" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8" FontSize="12" BorderBrush="#404040" BorderThickness="1" Background="White"/><TextBlock x:Name="StatusText" Text="The QR and URI contain a secret. Keep them private." FontSize="11" Foreground="#404040" TextWrapping="Wrap" Margin="2,8,2,0"/><Border x:Name="PreviewCard" Visibility="Collapsed" Background="#D4D0C8" BorderBrush="#808080" BorderThickness="2" Padding="10" Margin="0,12,0,0"><StackPanel><TextBlock Text="ACCOUNT FOUND" FontSize="9" FontWeight="Bold" Foreground="#000080"/><TextBlock x:Name="PreviewName" FontSize="14" FontWeight="Bold" Foreground="#101010" Margin="0,4,0,0"/></StackPanel></Border></StackPanel>
  <DockPanel Grid.Row="3" Margin="0,14,0,0"><Button Content="Cancel" IsCancel="True" DockPanel.Dock="Left" Background="#C0C0C0" Foreground="#101010" Padding="12,7" BorderBrush="#808080" BorderThickness="2"/><Button Content="Save account" Style="{StaticResource Primary}" IsDefault="True" HorizontalAlignment="Right" Click="Save_Click"/></DockPanel>
 </Grid>
</Window>
