<Window x:Class="WindowsOtpManager.ImportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Add authenticator account" Width="570" Height="650" MinWidth="530" MinHeight="620" WindowStartupLocation="CenterOwner" Background="#F4F6FA" FontFamily="Segoe UI" ResizeMode="CanResize">
 <Window.Resources>
  <Style x:Key="Primary" TargetType="Button"><Setter Property="Background" Value="#5146E5"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="16,10"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="Soft" TargetType="Button"><Setter Property="Background" Value="#ECEBFF"/><Setter Property="Foreground" Value="#4438CA"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="14,10"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
 </Window.Resources>
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="0,0,0,21"><TextBlock Text="Add an account" FontSize="25" FontWeight="Bold" Foreground="#171B2C"/><TextBlock Text="Copy your authenticator into SecureKey. The original account stays where it is." FontSize="12" Foreground="#777E91" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
  <Border Grid.Row="1" Background="White" CornerRadius="16" Padding="15" BorderBrush="#E7E9F1" BorderThickness="1" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="42" Height="42" Background="#EEF0FF" CornerRadius="13"><TextBlock Text="▣" FontSize="20" Foreground="#5145E5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0"><TextBlock Text="Scan QR code" FontWeight="SemiBold" Foreground="#252A3A"/><TextBlock Text="Choose a camera and scan your authenticator export." FontSize="11" Foreground="#858A9A" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="2" Style="{StaticResource Soft}" Content="Open camera" Click="Scan_Click"/></Grid></Border>
  <StackPanel Grid.Row="2"><TextBlock Text="OR IMPORT URI" FontSize="10" Foreground="#858B9B" FontWeight="Bold" Margin="2,0,0,9"/><TextBox x:Name="UriBox" Height="92" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10" FontSize="12" BorderBrush="#DDE0E8" Background="White"/><TextBlock x:Name="StatusText" Text="The QR and URI contain a secret. Keep them private." FontSize="11" Foreground="#7C8293" TextWrapping="Wrap" Margin="2,10,2,0"/><Border x:Name="PreviewCard" Visibility="Collapsed" Background="#EEF0FF" CornerRadius="12" Padding="13" Margin="0,14,0,0"><StackPanel><TextBlock Text="ACCOUNT FOUND" FontSize="9" FontWeight="Bold" Foreground="#5C52C7"/><TextBlock x:Name="PreviewName" FontSize="15" FontWeight="SemiBold" Foreground="#252A3A" Margin="0,4,0,0"/></StackPanel></Border></StackPanel>
  <DockPanel Grid.Row="3" Margin="0,20,0,0"><Button Content="Cancel" IsCancel="True" DockPanel.Dock="Left" Background="Transparent" Foreground="#687083" Padding="12,9" BorderThickness="0"/><Button Content="Save account" Style="{StaticResource Primary}" IsDefault="True" HorizontalAlignment="Right" Click="Save_Click"/></DockPanel>
 </Grid>
</Window>
