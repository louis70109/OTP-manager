<Window x:Class="WindowsOtpManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Windows OTP Manager" Width="1040" Height="780" MinWidth="820" MinHeight="620" Background="#F4F6FA" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style x:Key="Primary" TargetType="Button"><Setter Property="Background" Value="#5146E5"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="17,10"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="Quiet" TargetType="Button"><Setter Property="Background" Value="#F1F2F8"/><Setter Property="Foreground" Value="#475467"/><Setter Property="Padding" Value="10,7"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#151A2D"><DockPanel Margin="22,28,18,20"><StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" Margin="0,0,0,38"><Border Width="38" Height="38" CornerRadius="12" Background="#5145E5"><TextBlock Text="✦" Foreground="White" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="SecureKey" Foreground="White" FontSize="17" FontWeight="Bold"/><TextBlock Text="AUTHENTICATOR" Foreground="#8B91A8" FontSize="9" FontWeight="SemiBold"/></StackPanel></StackPanel><TextBlock Text="WORKSPACE" Foreground="#858BA2" FontSize="10" FontWeight="Bold" Margin="7,0,0,12"/><Border Background="#282D43" CornerRadius="10" Padding="12,11"><TextBlock Text="▦   My accounts" Foreground="White" FontWeight="SemiBold"/></Border></StackPanel><Border DockPanel.Dock="Bottom" Background="#20253A" CornerRadius="13" Padding="12"><StackPanel><TextBlock Text="◈  Protected on this device" Foreground="#D7DAE6" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Your secrets are encrypted locally." Foreground="#969CB2" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border></DockPanel></Border>
  <Grid Grid.Column="1" Margin="34,28,34,26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="0,0,0,23"><StackPanel><TextBlock Text="Authenticator" FontSize="27" FontWeight="Bold" Foreground="#171B2C"/><TextBlock Text="Your one-time codes, all in one place." FontSize="13" Foreground="#7B8193" Margin="0,4,0,0"/></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Primary}" Click="Add_Click" Content="＋   Add account"/></Grid>
   <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="14" Margin="0,0,0,18" BorderBrush="#EAECF2" BorderThickness="1"><DockPanel><TextBlock DockPanel.Dock="Left" Text="⌕" FontSize="23" Foreground="#858B9B" Margin="1,0,11,0" VerticalAlignment="Center"/><TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" FontSize="14" Foreground="#252A3A" VerticalContentAlignment="Center" ToolTip="Search accounts" TextChanged="Search_Changed"/><TextBlock DockPanel.Dock="Right" Text="SEARCH" FontSize="9" Foreground="#A0A5B3" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,2,0"/></DockPanel></Border>
   <Grid Grid.Row="2"><ListView x:Name="AccountsList" BorderThickness="0" Background="Transparent" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListView.ItemTemplate><DataTemplate><Border Background="White" CornerRadius="17" Padding="19" Margin="0,0,0,13" BorderBrush="#EAECF2" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="42" Height="42" Background="#EEF0FF" CornerRadius="13" VerticalAlignment="Top"><TextBlock Text="{Binding Initial}" FontSize="17" FontWeight="Bold" Foreground="#5145E5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Issuer}" FontSize="15" FontWeight="SemiBold" Foreground="#202438"/><TextBlock Text="{Binding Account}" FontSize="12" Foreground="#858A9A" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="2" Style="{StaticResource Quiet}" Content="⋯" FontSize="18" Padding="10,2" Tag="{Binding Id}" Click="Delete_Click" ToolTip="Delete account"/><Button Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Background="#F7F7FC" Padding="13,10" HorizontalContentAlignment="Left" Tag="{Binding Id}" Click="Copy_Code_Click" ToolTip="Click the code to copy it" Margin="0,17,0,14"><DockPanel><TextBlock Text="{Binding DisplayCode}" FontSize="29" FontFamily="Cascadia Code, Consolas" FontWeight="SemiBold" Foreground="#242842"/><TextBlock DockPanel.Dock="Right" Text="▢  COPY" FontSize="9" FontWeight="Bold" Foreground="#737991" VerticalAlignment="Center" Margin="12,0,2,0"/></DockPanel></Button><ProgressBar Grid.Row="2" Grid.Column="1" Value="{Binding Remaining, Mode=OneWay}" Maximum="{Binding Period, Mode=OneWay}" Height="4" Background="#E9EAF2" Foreground="#675CE7" BorderThickness="0"/><TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Remaining, Mode=OneWay, StringFormat={}{0}s}" FontSize="10" Foreground="#83899A" HorizontalAlignment="Right" Margin="8,0,0,0"/></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
    <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="390" Visibility="Collapsed"><Border Width="76" Height="76" Background="#ECEBFF" CornerRadius="24" HorizontalAlignment="Center"><TextBlock Text="✦" FontSize="34" Foreground="#5449DE" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Your codes start here" FontSize="20" FontWeight="Bold" Foreground="#202438" HorizontalAlignment="Center" Margin="0,18,0,6"/><TextBlock Text="Scan an authenticator QR code with your camera, or import an otpauth URI to add your first account." TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="#7B8193"/><Button Style="{StaticResource Primary}" Content="＋   Add your first account" Click="Add_Click" HorizontalAlignment="Center" Margin="0,18,0,0"/></StackPanel>
   </Grid><DockPanel Grid.Row="3" Margin="2,15,2,0"><TextBlock x:Name="AccountCount" DockPanel.Dock="Left" Text="0 accounts" FontSize="11" Foreground="#858B9B"/><TextBlock Text="Codes refresh automatically" FontSize="11" Foreground="#858B9B" HorizontalAlignment="Right"/></DockPanel>
  </Grid>
 </Grid>
</Window>
