<Window x:Class="WindowsOtpManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Windows OTP Manager" Width="1040" Height="780" MinWidth="820" MinHeight="620" Background="#C0C0C0" FontFamily="Tahoma" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style x:Key="Primary" TargetType="Button"><Setter Property="Background" Value="#C0C0C0"/><Setter Property="Foreground" Value="#101010"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="14,7"/><Setter Property="BorderBrush" Value="#404040"/><Setter Property="BorderThickness" Value="2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="2"/></Style>
  <Style x:Key="Quiet" TargetType="Button"><Setter Property="Background" Value="#C0C0C0"/><Setter Property="Foreground" Value="#101010"/><Setter Property="Padding" Value="8,4"/><Setter Property="BorderBrush" Value="#808080"/><Setter Property="BorderThickness" Value="2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="2"/></Style>
 </Window.Resources>
 <Grid Margin="6"><Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#C0C0C0" BorderBrush="#FFFFFF" BorderThickness="2" Margin="0,0,6,0"><DockPanel Margin="9"><StackPanel DockPanel.Dock="Top"><Border Background="#000080" Padding="7" Margin="0,0,0,12"><StackPanel><TextBlock Text="Windows OTP" Foreground="White" FontSize="16" FontWeight="Bold"/><TextBlock Text="SECURE AUTHENTICATOR" Foreground="#D8D8FF" FontSize="9" Margin="0,4,0,0"/></StackPanel></Border><TextBlock Text="WORKSPACE" Foreground="#404040" FontSize="10" FontWeight="Bold" Margin="4,0,0,7"/><Border Background="#000080" Padding="8" BorderBrush="#FFFFFF" BorderThickness="1"><TextBlock Text="▦   My accounts" Foreground="White" FontWeight="Bold"/></Border></StackPanel><Border DockPanel.Dock="Bottom" Background="#D4D0C8" BorderBrush="#808080" BorderThickness="1" Padding="8"><StackPanel><TextBlock Text="◈ Protected on this device" Foreground="#202020" FontSize="11" FontWeight="Bold"/><TextBlock Text="Your secrets are encrypted locally." Foreground="#404040" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border></DockPanel></Border>
  <Grid Grid.Column="1" Margin="8,0,2,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Grid.Row="0" Background="#000080" Padding="10" Margin="0,0,0,10"><Grid><StackPanel><TextBlock Text="Authenticator" FontSize="21" FontWeight="Bold" Foreground="White"/><TextBlock Text="Your one-time codes, all in one place." FontSize="12" Foreground="#E4E4FF" Margin="0,3,0,0"/></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Primary}" Click="Add_Click" Content="＋  Add account"/></Grid></Border>
   <Border Grid.Row="1" Background="#D4D0C8" BorderBrush="#808080" BorderThickness="2" Padding="8" Margin="0,0,0,9"><DockPanel><TextBlock DockPanel.Dock="Left" Text="⌕" FontSize="20" Foreground="#202020" Margin="2,0,8,0" VerticalAlignment="Center"/><TextBox x:Name="SearchBox" BorderBrush="#404040" BorderThickness="1" Background="White" FontSize="13" Foreground="#101010" VerticalContentAlignment="Center" Padding="5,3" ToolTip="Search accounts" TextChanged="Search_Changed"/><TextBlock DockPanel.Dock="Right" Text="SEARCH" FontSize="9" Foreground="#404040" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,2,0"/></DockPanel></Border>
   <Grid Grid.Row="2"><ListView x:Name="AccountsList" BorderBrush="#808080" BorderThickness="2" Background="#D4D0C8" Padding="5" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListView.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListView.ItemsPanel><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="3"/></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate><Border Background="#D4D0C8" BorderBrush="#808080" BorderThickness="1" Padding="10" Margin="0,0,0,8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="36" Height="36" Background="#000080" BorderBrush="White" BorderThickness="1" VerticalAlignment="Top"><TextBlock Text="{Binding Initial}" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Issuer}" FontSize="14" FontWeight="Bold" Foreground="#101010"/><TextBlock Text="{Binding Account}" FontSize="11" Foreground="#404040" Margin="0,2,0,0"/></StackPanel><Button Grid.Column="2" Style="{StaticResource Quiet}" Content="⋯" FontSize="16" Padding="8,0" Tag="{Binding Id}" Click="Delete_Click" ToolTip="Delete account"/><Button Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Background="#FFFFFF" BorderBrush="#404040" BorderThickness="1" Padding="10,8" HorizontalContentAlignment="Left" Tag="{Binding Id}" Click="Copy_Code_Click" ToolTip="Click the code to copy it" Margin="0,11,0,9"><DockPanel><TextBlock Text="{Binding DisplayCode}" FontSize="27" FontFamily="Consolas" FontWeight="Bold" Foreground="#000080"/><TextBlock DockPanel.Dock="Right" Text="▢  COPY" FontSize="9" FontWeight="Bold" Foreground="#404040" VerticalAlignment="Center" Margin="10,0,2,0"/></DockPanel></Button><ProgressBar Grid.Row="2" Grid.Column="1" Value="{Binding Remaining, Mode=OneWay}" Maximum="{Binding Period, Mode=OneWay}" Height="5" Background="#808080" Foreground="#000080" BorderThickness="1"/><TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Remaining, Mode=OneWay, StringFormat={}{0}s}" FontSize="10" Foreground="#202020" HorizontalAlignment="Right" Margin="8,0,0,0"/></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
    <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="390" Visibility="Collapsed" Background="#D4D0C8"><Border Width="64" Height="64" Background="#000080" BorderBrush="White" BorderThickness="2" HorizontalAlignment="Center"><TextBlock Text="✦" FontSize="31" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Your codes start here" FontSize="18" FontWeight="Bold" Foreground="#101010" HorizontalAlignment="Center" Margin="0,14,0,5"/><TextBlock Text="Scan an authenticator QR code with your camera, or import an otpauth URI to add your first account." TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Foreground="#404040"/><Button Style="{StaticResource Primary}" Content="＋  Add your first account" Click="Add_Click" HorizontalAlignment="Center" Margin="0,14,0,0"/></StackPanel>
   </Grid><DockPanel Grid.Row="3" Margin="2,9,2,0"><TextBlock x:Name="AccountCount" DockPanel.Dock="Left" Text="0 accounts" FontSize="11" Foreground="#202020"/><TextBlock Text="Codes refresh automatically" FontSize="11" Foreground="#202020" HorizontalAlignment="Right"/></DockPanel>
  </Grid>
 </Grid>
</Window>
